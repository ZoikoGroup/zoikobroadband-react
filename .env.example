# Linko chatbot configuration — names only. Copy to .env.local and fill in.
# Never commit real values. Use separate keys for development, staging and production.

# ── AI provider (server-only; never prefix with NEXT_PUBLIC_) ──
# groq (default) or anthropic. There is no automatic fallback between providers (Doc14 PLAT-06).
LINKO_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_ALLOWLIST=openai/gpt-oss-120b,openai/gpt-oss-20b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_MODEL_ALLOWLIST=claude-opus-5-5
CLAUDE_MAX_OUTPUT_TOKENS=4000
# Environment tag of each key; if set, it must equal LINKO_ENVIRONMENT or the AI stays off (Doc14 AT14-003)
GROQ_KEY_ENVIRONMENT=
ANTHROPIC_KEY_ENVIRONMENT=
LINKO_ENVIRONMENT=development

# ── Kill switch and knowledge ──
# The AI is OFF unless this is exactly "true" (Doc08 §10.2)
LINKO_AI_ENABLED=
# Draft (unapproved) knowledge is not served unless "true" (Doc13 §06.1) — development / pre-approval only
LINKO_ALLOW_DRAFT_KB=

# ── Limits and budgets (Doc14 §06) ──
LINKO_MAX_TURNS=30
LINKO_DAILY_TOKEN_BUDGET=2000000
LINKO_MONTHLY_TOKEN_BUDGET=30000000
LINKO_MAX_INPUT_TOKENS=6000

# ── Cost metering (USD per million tokens, from the effective price book) ──
LINKO_PRICE_INPUT_PER_M=
LINKO_PRICE_OUTPUT_PER_M=
LINKO_PRICE_CACHE_WRITE_PER_M=
LINKO_PRICE_CACHE_READ_PER_M=
LINKO_PRICE_VERSION=

# ── Database (Doc05) ──
# SQLite file (default .data/linko.db, git-ignored)
LINKO_DB_PATH=
# 32-byte base64 key for AES-256-GCM encryption of stored chat text and staff notes.
# Without it, no message text is stored at all (only digests). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINKO_DATA_KEY=
# Key rotation: "k2:<base64>,k1:<base64>" with LINKO_DATA_KEY_ID naming the key for new data
LINKO_DATA_KEYS=
LINKO_DATA_KEY_ID=
# Salt for audit subject pseudonyms — REQUIRED in production
LINKO_AUDIT_SALT=
# Set to false in production and run `npm run linko:migrate` as a deploy step instead
LINKO_DB_AUTO_MIGRATE=
# Encrypted backups (`npm run linko:backup`)
LINKO_BACKUP_KEY=
LINKO_BACKUP_DIR=

# ── Staff console (Doc10 / Doc13) — open decisions D13-17/18, these are defaults ──
LINKO_STAFF_IDLE_MINUTES=15
LINKO_STAFF_MAX_HOURS=8
LINKO_STAFF_STEPUP_MINUTES=5
LINKO_STAFF_MAX_FAILED_LOGINS=5
LINKO_STAFF_LOCK_MINUTES=15
LINKO_STAFF_MAX_ACTIVE_CASES=5

# ── Operations ──
LINKO_RELEASE=
LINKO_HEALTH_TOKEN=
LINKO_ALLOWED_ORIGINS=

# ── Integrations (off until connected; Linko fails closed without them) ──
LINKO_QUALIFICATION_ADAPTER=
LINKO_CRM_LEAD_WEBHOOK_URL=
LINKO_CRM_COMPLAINT_WEBHOOK_URL=
LINKO_STATUS_FEED_URL=

# ── Browser ──
NEXT_PUBLIC_LINKO_ENABLED=true
NEXT_PUBLIC_LINKO_HISTORY_TTL_DAYS=30
